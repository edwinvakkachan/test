<!DOCTYPE html>
<html>
<head>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<h1>ToDo App</h1>

<form action="/add" method="POST">
  <input type="text" name="task" required>
  <button>Add</button>
</form>

<ul>
  <% tasks.forEach(task => { %>
    <li>
      <%= task.task %>
      <form action="/delete/<%= task.id %>" method="POST">
        <button>Delete</button>
      </form>
    </li>
  <% }) %>
</ul>

</body>
</html>